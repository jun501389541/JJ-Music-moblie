+import 'dart:convert';
+import 'dart:io';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:jj_music_mobile/data/prototype_recovery/file_snapshot_store.dart';
+import 'package:jj_music_mobile/domain/playback/contracts.dart';
+import 'package:jj_music_mobile/domain/playback/recovery_snapshot.dart';
+
+import '../../integration_test/support/local_playback_contract.dart';
+
+void main() {
+  late Directory root;
+  FileSnapshotStore store() => FileSnapshotStore(
+    root: root,
+    runId: 'run-a',
+    allowedFixtureIds: {'tone-a'},
+  );
+  RecoverySnapshot snapshot(int revision) => RecoverySnapshot(
+    runId: 'run-a',
+    revision: revision,
+    playbackSessionId: 'session-a',
+    entries: [fixtureA, fixtureB],
+    currentIndex: 1,
+    positionMs: 1234,
+    confirmations: ['session-a:1'],
+  );
+  setUp(() async {
+    root = await Directory.systemTemp.createTemp('jj-music-prototype-');
+  });
+  tearDown(() async {
+    await root.delete(recursive: true);
+  });
+  test('TC-05 saved receipt means real bytes and a fresh store reads the same revision paused', () async {
+    final receipt = await store().save(snapshot(7));
+    expect(receipt.revision, 7);
+    expect(await Directory('${root.path}/run-a').exists(), isTrue);
+    final result = await store().load();
+    expect(result.snapshot?.revision, 7);
+    expect(result.snapshot?.positionMs, 1234);
+    expect(result.snapshot?.entries[1].entryId, 'occurrence-b');
+    expect(result.restoredTransport, DesiredTransport.paused);
+  });
+  test(
+    'concurrent out-of-order writes cannot replace a higher saved revision',
+    () async {
+      final s = store();
+      final newer = s.save(snapshot(5));
+      final older = s.save(snapshot(4));
+      await expectLater(older, throwsA(isA<StateError>()));
+      await newer;
+      expect((await store().load()).snapshot?.revision, 5);
+    },
+  );
+  test('missing, corrupt, oversized, unknown version and unavailable fixture are safe', () async {
+    expect((await store().load()).snapshot, isNull);
+    final dir = await Directory('${root.path}/run-a').create(recursive: true);
+    final file = File('${dir.path}/snapshot-a.json');
+    for (final data in [
+      '{broken',
+      jsonEncode({...snapshot(2).toJson(), 'formatVersion': 99}),
+      ' ' * (256 * 1024 + 1),
+      jsonEncode({
+        ...snapshot(2).toJson(),
+        'entries': [
+          {'entryId': 'a', 'trackKey': 'x', 'fixtureId': 'not-allowed'},
+        ],
+        'currentIndex': 0,
+      }),
+    ]) {
+      await file.writeAsString(data);
+      final result = await store().load();
+      expect(result.snapshot, isNull);
+      expect(result.issues, isNotEmpty);
+    }
+  });
+  test('interrupted temporary write and corrupt newest slot retain a last valid snapshot', () async {
+    final s = store();
+    await s.save(snapshot(1));
+    await s.save(snapshot(2));
+    final dir = Directory('${root.path}/run-a');
+    await File('${dir.path}/snapshot-a.json').writeAsString('{partial');
+    await File('${dir.path}/snapshot-b.json.tmp').writeAsString('{unfinished');
+    expect((await store().load()).snapshot?.revision, 1);
+  });
+  test(
+    'forbidden runtime fields and oversized queues cannot be persisted',
+    () async {
+      await expectLater(
+        store().save(
+          RecoverySnapshot(
+            runId: 'run-a',
+            revision: 1,
+            playbackSessionId: 'session',
+            entries: List.generate(
+              17,
+              (i) => QueueEntry(
+                entryId: 'e$i',
+                trackKey: 'tone',
+                fixtureId: 'tone-a',
+              ),
+            ),
+            currentIndex: 0,
+          ),
+        ),
+        throwsA(isA<FormatException>()),
+      );
+      final dir = await Directory('${root.path}/run-a').create(recursive: true);
+      await File('${dir.path}/snapshot-a.json').writeAsString(
+        jsonEncode({...snapshot(1).toJson(), 'token': 'synthetic-secret'}),
+      );
+      expect((await store().load()).snapshot, isNull);
+    },
+  );
+}
diff --git a/clients/flutter/tool/fetch_gradle.ps1 b/clients/flutter/tool/fetch_gradle.ps1
new file mode 100644
index 0000000..fbe58a0
--- /dev/null
+++ b/clients/flutter/tool/fetch_gradle.ps1
@@ -0,0 +1,37 @@
+# Fixed official Gradle 9.3.1 binary distribution. No global configuration writes.
+$ErrorActionPreference='Stop'
+$root=Join-Path $PSScriptRoot '../.dart_tool/gradle-download'
+$total=137037885L
+$size=[long][Math]::Ceiling($total/24)
+0..23 | ForEach-Object -Parallel {
+  $p=Join-Path $using:root ('part-{0:D2}.bin' -f $_)
+  $start=[long]$_*$using:size
+  $end=[Math]::Min($start+$using:size-1,$using:total-1)
+  for($try=0;$try -lt 20;$try++){
+    $have=if(Test-Path $p){(Get-Item $p).Length}else{0L}
+    if($have -eq ($end-$start+1)){break}
+    if($have -gt ($end-$start+1)){throw 'Oversize chunk'}
+    $from=$start+$have
+    curl.exe -fsSL --connect-timeout 12 --max-time 30 --range "$from-$end" --dump-header "$p.headers" --output "$p.tail" https://downloads.gradle.org/distributions/gradle-9.3.1-bin.zip 2>$null
+    if((Test-Path "$p.tail") -and ((Get-Content "$p.headers" -Raw) -match "(?im)^content-range: bytes $from-$end/137037885")){
+      $length=(Get-Item "$p.tail").Length
+      if($length -gt 0 -and $length -le ($end-$from+1)){
+        $a=[IO.File]::Open($p,[IO.FileMode]::Append);$b=[IO.File]::OpenRead("$p.tail")
+        try{$b.CopyTo($a)}finally{$b.Dispose();$a.Dispose()}
+      }
+    }
+  }
+  if(!(Test-Path $p) -or (Get-Item $p).Length -ne ($end-$start+1)){throw "Incomplete chunk $_"}
+  "Gradle chunk $_ complete"
+} -ThrottleLimit 24
+$parts=Get-ChildItem $root -Filter 'part-*.bin' | Sort-Object Name
+if($parts.Count -ne 24 -or ($parts|Measure-Object Length -Sum).Sum -ne $total){throw 'Incomplete Gradle download'}
+$zip=Join-Path $root 'gradle-9.3.1-bin.zip'
+$out=[IO.File]::Create($zip)
+try{foreach($part in $parts){$inputFile=[IO.File]::OpenRead($part.FullName);try{$inputFile.CopyTo($out)}finally{$inputFile.Dispose()}}}finally{$out.Dispose()}
+$hash=(Get-FileHash $zip -Algorithm SHA256).Hash.ToLower()
+if($hash -ne 'b266d5ff6b90eada6dc3b20cb090e3731302e553a27c5d3e4df1f0d76beaff06'){throw 'Gradle official SHA256 mismatch'}
+$cache=Join-Path (Split-Path $PSScriptRoot -Parent) '.gradle-user-home/wrapper/dists/gradle-9.3.1-bin/30eg2jcb8eqk5ro0gq9h8x6ef'
+New-Item -ItemType Directory $cache -Force | Out-Null
+Copy-Item -LiteralPath $zip -Destination (Join-Path $cache 'gradle-9.3.1-bin.zip')
+"Verified Gradle SHA256=$hash and seeded project wrapper cache"
diff --git a/clients/flutter/tool/flutter_with_proxy.ps1 b/clients/flutter/tool/flutter_with_proxy.ps1
new file mode 100644
index 0000000..07e2c8c
--- /dev/null
+++ b/clients/flutter/tool/flutter_with_proxy.ps1
@@ -0,0 +1,32 @@
+# Map the existing proxy to Java only for this child build process. No global writes.
+param([Parameter(ValueFromRemainingArguments=$true)][string[]]$FlutterArgs)
+$oldOptions=$env:JAVA_TOOL_OPTIONS
+$oldGradleHome=$env:GRADLE_USER_HOME
+$oldReadOnlyCache=$env:GRADLE_RO_DEP_CACHE
+try {
+  # Isolate this prototype from pre-existing user init scripts used by other apps.
+  $projectRoot=Split-Path $PSScriptRoot -Parent
+  $env:GRADLE_USER_HOME=Join-Path $projectRoot '.gradle-user-home'
+    $initDirectory=Join-Path $env:GRADLE_USER_HOME 'init.d'
+  New-Item -ItemType Directory $initDirectory -Force | Out-Null
+  Copy-Item -LiteralPath (Join-Path $PSScriptRoot 'gradle_repositories.init.gradle') -Destination (Join-Path $initDirectory 'project-repositories.gradle') -Force
+  if($oldGradleHome -and (Test-Path (Join-Path $oldGradleHome 'caches/modules-2'))){$env:GRADLE_RO_DEP_CACHE=Join-Path $oldGradleHome 'caches'}
+  $cache=Join-Path $env:GRADLE_USER_HOME 'wrapper/dists/gradle-9.3.1-bin/30eg2jcb8eqk5ro0gq9h8x6ef'
+  $download=Join-Path $projectRoot '.dart_tool/gradle-download/gradle-9.3.1-bin.zip'
+  if(!(Test-Path (Join-Path $cache 'gradle-9.3.1/bin/gradle.bat')) -and (Test-Path $download)){
+    if((Get-FileHash $download -Algorithm SHA256).Hash.ToLower() -ne 'b266d5ff6b90eada6dc3b20cb090e3731302e553a27c5d3e4df1f0d76beaff06'){throw 'Gradle checksum mismatch'}
+    New-Item -ItemType Directory $cache -Force | Out-Null
+    Copy-Item -LiteralPath $download -Destination (Join-Path $cache 'gradle-9.3.1-bin.zip')
+  }
+  if($env:HTTPS_PROXY -or $env:HTTP_PROXY) {
+    $proxyText=if($env:HTTPS_PROXY){$env:HTTPS_PROXY}else{$env:HTTP_PROXY}
+    $proxyUri=[Uri]$proxyText
+    if($proxyUri.UserInfo){throw 'Authenticated proxy needs a separate credential-safe setup'}
+    $env:JAVA_TOOL_OPTIONS=($oldOptions+' -Dhttps.proxyHost='+$proxyUri.Host+' -Dhttps.proxyPort='+$proxyUri.Port+' -Dhttp.proxyHost='+$proxyUri.Host+' -Dhttp.proxyPort='+$proxyUri.Port+' -Dhttp.nonProxyHosts=localhost|127.*|[::1]').Trim()
+  }
+  & flutter @FlutterArgs
+  $result=$LASTEXITCODE
+} finally { $env:JAVA_TOOL_OPTIONS=$oldOptions; $env:GRADLE_USER_HOME=$oldGradleHome; $env:GRADLE_RO_DEP_CACHE=$oldReadOnlyCache }
+exit $result
+
+
diff --git a/clients/flutter/tool/generate_fixtures.dart b/clients/flutter/tool/generate_fixtures.dart
