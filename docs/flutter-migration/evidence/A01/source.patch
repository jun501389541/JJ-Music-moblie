diff --git a/clients/flutter/integration_test/diagnostic_smoke_test.dart b/clients/flutter/integration_test/diagnostic_smoke_test.dart
new file mode 100644
index 0000000..289d214
--- /dev/null
+++ b/clients/flutter/integration_test/diagnostic_smoke_test.dart
@@ -0,0 +1,53 @@
+import 'dart:io';
+import 'dart:ui' as ui;
+
+import 'package:flutter/rendering.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:integration_test/integration_test.dart';
+import 'package:jj_music_mobile/main.dart' as app;
+
+void main() {
+  IntegrationTestWidgetsFlutterBinding.ensureInitialized();
+  testWidgets(
+    'A01/A02 native shell startup control and real-file diagnostics',
+    (tester) async {
+      app.main();
+      await tester.pumpAndSettle();
+      expect(find.text('JJ-Music 技术诊断'), findsOneWidget);
+      await tester.tap(find.text('运行入口检查'));
+      await tester.pumpAndSettle();
+      expect(find.textContaining('入口检查通过'), findsOneWidget);
+      Future<void> check(String button, String expected) async {
+        await tester.tap(find.text(button));
+        for (var i = 0; i < 100; i++) {
+          await tester.runAsync(
+            () => Future<void>.delayed(const Duration(milliseconds: 50)),
+          );
+          await tester.pump();
+          if (find.textContaining(expected).evaluate().isNotEmpty) {
+            return;
+          }
+        }
+        expect(find.textContaining(expected), findsOneWidget);
+      }
+
+      await check('运行共享合同自检', '共享合同检查通过');
+      await check('保存并读回测试快照', '快照写读检查通过');
+      final frame = tester.renderObject<RenderRepaintBoundary>(
+        find.byKey(const Key('diagnostic-frame')),
+      );
+      await tester.runAsync(() async {
+        final image = await frame.toImage();
+        final bytes = await image.toByteData(format: ui.ImageByteFormat.png);
+        final path = Platform.isWindows
+            ? '../../docs/flutter-migration/evidence/A01/windows-diagnostic.png'
+            : '${Directory.systemTemp.path}/diagnostic-smoke.png';
+        await File(path).writeAsBytes(bytes!.buffer.asUint8List(), flush: true);
+        image.dispose();
+        // Path contains only this diagnostic app's own cache location.
+        // ignore: avoid_print
+        print('DIAGNOSTIC_SCREENSHOT=$path');
+      });
+    },
+  );
+}
diff --git a/clients/flutter/integration_test/support/controlled_backend.dart b/clients/flutter/integration_test/support/controlled_backend.dart
new file mode 100644
index 0000000..eceb3dc
--- /dev/null
+++ b/clients/flutter/integration_test/support/controlled_backend.dart
@@ -0,0 +1,92 @@
+import 'dart:async';
+
+import 'package:jj_music_mobile/domain/playback/contracts.dart';
+
+/// Test-only controllable I/O boundary: never decodes or outputs audio.
+class ControlledBackend implements PlaybackBackend {
+  final pending = <String, Completer<PreparedTrack>>{};
+  final requests = <String, PrepareRequest>{};
+  final actions = <String>[];
+  final releases = <String, Completer<ReleaseReceipt>>{};
+  final _events = StreamController<BackendEvent>.broadcast(sync: true);
+  bool holdRelease = false;
+  bool holdPlay = false;
+  final playing = Completer<void>();
+  @override
+  Stream<BackendEvent> get events => _events.stream;
+  @override
+  Future<PreparedTrack> prepare(PrepareRequest request) {
+    requests[request.requestId] = request;
+    actions.add('prepare:${request.requestId}');
+    return (pending[request.requestId] = Completer<PreparedTrack>()).future;
+  }
+
+  void ready(String id, String handle) => pending[id]!.complete(
+    PreparedTrack(
+      handle,
+      consumerId: 'consumer-$handle',
+      resourceRevision: 'fixture-v1',
+    ),
+  );
+  void emit(
+    String id,
+    String handle,
+    BackendEventKind kind,
+    int sequence, {
+    String? evidence = 'controlled-contract-v1',
+    int? epoch,
+    int? generation,
+    String? transitionId,
+  }) {
+    final r = requests[id]!;
+    _events.add(
+      BackendEvent(
+        kind: kind,
+        trackHandleId: handle,
+        requestId: id,
+        backendEpoch: epoch ?? r.backendEpoch,
+        generation: generation ?? r.generation,
+        eventSequence: sequence,
+        confirmationEvidence: evidence,
+        transitionId: transitionId ?? r.transitionId,
+      ),
+    );
+  }
+
+  @override
+  Future<void> cancelPrepare(String requestId) async {
+    actions.add('cancel:$requestId');
+  }
+
+  @override
+  Future<void> play(String handle) {
+    actions.add('play:$handle');
+    return holdPlay ? playing.future : Future.value();
+  }
+
+  @override
+  Future<void> pause() async {
+    actions.add('pause');
+  }
+
+  @override
+  Future<void> stop() async {
+    actions.add('stop');
+  }
+
+  @override
+  Future<void> seek(String handle, int positionMs) async {
+    actions.add('seek:$handle:$positionMs');
+  }
+
+  @override
+  Future<ReleaseReceipt> release(String handle, String consumer, int epoch) {
+    actions.add('release:$handle');
+    if (holdRelease) {
+      return (releases[handle] = Completer<ReleaseReceipt>()).future;
+    }
+    return Future.value(ReleaseReceipt(handle, consumer, epoch));
+  }
+
+  Future<void> close() => _events.close();
+}
diff --git a/clients/flutter/integration_test/support/local_playback_contract.dart b/clients/flutter/integration_test/support/local_playback_contract.dart
new file mode 100644
index 0000000..8cf2f37
--- /dev/null
+++ b/clients/flutter/integration_test/support/local_playback_contract.dart
@@ -0,0 +1,146 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:jj_music_mobile/application/playback/playback_coordinator.dart';
+import 'package:jj_music_mobile/domain/playback/contracts.dart';
+
+import 'controlled_backend.dart';
+
+const fixtureA = QueueEntry(
+  entryId: 'occurrence-a',
+  trackKey: 'tone',
+  fixtureId: 'tone-a',
+);
+const fixtureB = QueueEntry(
+  entryId: 'occurrence-b',
+  trackKey: 'tone',
+  fixtureId: 'tone-a',
+);
+Future<void> flushContractEvents() => Future<void>.delayed(Duration.zero);
+
+/// Reusable postconditions: future real adapters import these without reusing the fake.
+void expectControlApplied(CommandAck ack) {
+  expect(ack.accepted, isTrue);
+  expect(ack.applied, isTrue);
+  expect(ack.failure, isNull);
+}
+
+void expectConfirmedIdentity(
+  PlaybackSnapshot state,
+  String entryId,
+  int count,
+) {
+  expect(state.currentEntryId, entryId);
+  expect(state.confirmations.length, count);
+  expect(state.confirmations.toSet().length, count);
+}
+
+/// Shared assertions for A02. Platform adapters consume the frozen contract later.
+void registerLocalPlaybackContract() {
+  late ControlledBackend backend;
+  late PlaybackCoordinator coordinator;
+  CommandContext command(String id) => CommandContext(id, coordinator.claim);
+  PlayIntent intent(QueueEntry entry) =>
+      PlayIntent(entries: [fixtureA, fixtureB], entryId: entry.entryId);
+  setUp(() {
+    backend = ControlledBackend();
+    coordinator = PlaybackCoordinator(backend);
+  });
+  tearDown(() async {
+    await coordinator.dispose();
+    await backend.close();
+  });
+
+  for (final control in ['stop', 'pause', 'cancel', 'new-play']) {
+    test(
+      'TC-56 $control is dispatched before an old prepare Future completes',
+      () async {
+        coordinator.play(command('old'), intent(fixtureA));
+        final ack = switch (control) {
+          'stop' => coordinator.stop(command('control')),
+          'pause' => coordinator.pause(command('control')),
+          'cancel' => coordinator.cancel(command('control'), 'old'),
+          _ => coordinator.play(command('new'), intent(fixtureB)),
+        };
+        expectControlApplied(ack);
+        expect(backend.pending['old']!.isCompleted, isFalse);
+        expect(
+          backend.actions,
+          contains(switch (control) {
+            'new-play' => 'prepare:new',
+            'cancel' => 'cancel:old',
+            _ => control,
+          }),
+        );
+        backend.ready('old', 'late-handle');
+        await flushContractEvents();
+        if (control != 'pause') {
+          expect(backend.actions, isNot(contains('play:late-handle')));
+        }
+        if (control == 'pause') {
+          expect(coordinator.snapshot.desired, DesiredTransport.paused);
+          expect(backend.actions, isNot(contains('play:late-handle')));
+        }
+        expect(coordinator.snapshot.confirmations, isEmpty);
+      },
+    );
+  }
+  test('TC-57 raw playing, ready and buffering do not confirm; normalized confirmation deduplicates', () async {
+    coordinator.play(command('p'), intent(fixtureA));
+    backend.ready('p', 'a');
+    await flushContractEvents();
+    backend.emit('p', 'a', BackendEventKind.ready, 1);
+    backend.emit('p', 'a', BackendEventKind.buffering, 2);
+    backend.emit('p', 'a', BackendEventKind.playing, 3, evidence: null);
+    expect(coordinator.snapshot.confirmations, isEmpty);
+    backend.emit('p', 'a', BackendEventKind.playing, 4);
+    backend.emit('p', 'a', BackendEventKind.playing, 5);
+    expect(coordinator.snapshot.confirmations.length, 1);
+    expect(coordinator.snapshot.currentEntryId, 'occurrence-a');
+    expect(coordinator.snapshot.durationMs, isNull);
+  });
+  test('TC-03/32 stale epoch, generation and duplicate events never commit identity', () async {
+    coordinator.play(command('p'), intent(fixtureA));
+    backend.ready('p', 'a');
+    await flushContractEvents();
+    backend.emit('p', 'a', BackendEventKind.playing, 1, epoch: 99);
+    backend.emit('p', 'a', BackendEventKind.playing, 2, generation: 99);
+    expect(coordinator.snapshot.currentEntryId, isNull);
+    backend.emit('p', 'a', BackendEventKind.playing, 3);
+    backend.emit('p', 'a', BackendEventKind.error, 2);
+    expect(coordinator.snapshot.currentEntryId, 'occurrence-a');
+    expect(coordinator.snapshot.confirmations.length, 1);
+  });
+  test('TC-06/07 incoming failure preserves outgoing resource and rollback retains confirmed history', () async {
+    coordinator.play(command('p'), intent(fixtureA));
+    backend.ready('p', 'a');
+    await flushContractEvents();
+    backend.emit('p', 'a', BackendEventKind.playing, 1);
+    coordinator.play(command('q'), intent(fixtureB));
+    backend.ready('q', 'b');
+    await flushContractEvents();
+    expect(coordinator.snapshot.currentEntryId, 'occurrence-a');
+    backend.emit('q', 'b', BackendEventKind.playing, 1);
+    expect(coordinator.snapshot.currentEntryId, 'occurrence-b');
+    expect(backend.actions, isNot(contains('release:a')));
+    backend.emit('q', 'b', BackendEventKind.error, 2);
+    await flushContractEvents();
+    expect(coordinator.snapshot.currentEntryId, 'occurrence-a');
+    expect(coordinator.snapshot.confirmations.length, 2);
+  });
+  test(
+    'TC-09 stop applied is separate from physical release receipt',
+    () async {
+      backend.holdRelease = true;
+      coordinator.play(command('p'), intent(fixtureA));
+      backend.ready('p', 'a');
+      await flushContractEvents();
+      backend.emit('p', 'a', BackendEventKind.playing, 1);
+      expect(coordinator.stop(command('s')).applied, isTrue);
+      expect(coordinator.snapshot.tracks.single.role, TrackRole.retiring);
+      backend.releases['a']!.complete(
+        const ReleaseReceipt('a', 'consumer-a', 1),
+      );
+      await flushContractEvents();
+      expect(coordinator.snapshot.tracks.single.role, TrackRole.released);
+    },
+  );
+}
diff --git a/clients/flutter/lib/app/diagnostic_checks.dart b/clients/flutter/lib/app/diagnostic_checks.dart
new file mode 100644
index 0000000..335470d
--- /dev/null
+++ b/clients/flutter/lib/app/diagnostic_checks.dart
@@ -0,0 +1,139 @@
+import 'dart:async';
+import 'dart:io';
+
+import '../application/playback/playback_coordinator.dart';
+import '../data/prototype_recovery/file_snapshot_store.dart';
+import '../domain/playback/contracts.dart';
+import '../domain/playback/recovery_snapshot.dart';
+
+class DiagnosticReport {
+  const DiagnosticReport(this.passed, this.details);
+  final bool passed;
+  final String details;
+}
+
+class DiagnosticChecks {
+  static final _runId = 'diag-$pid-${DateTime.now().microsecondsSinceEpoch}';
+  static const _entry = QueueEntry(
+    entryId: 'diagnostic-a',
+    trackKey: 'tone',
+    fixtureId: 'tone-a',
+  );
+  static Future<DiagnosticReport> control() async {
+    final backend = _PendingDiagnosticBackend();
+    final coordinator = PlaybackCoordinator(backend);
+    try {
+      coordinator.play(
+        CommandContext('prepare', coordinator.claim),
+        PlayIntent(entries: [_entry], entryId: _entry.entryId),
+      );
+      final pending = !backend.preparation.isCompleted;
+      final ack = coordinator.stop(CommandContext('stop', coordinator.claim));
+      final dispatched = backend.actions.contains('stop');
+      backend.preparation.complete(
+        const PreparedTrack(
+          'late-diagnostic',
+          consumerId: 'diagnostic-reader',
+          resourceRevision: 'tone-v1',
+        ),
+      );
+      await Future<void>.delayed(Duration.zero);
+      final passed =
+          pending &&
+          ack.accepted &&
+          ack.applied &&
+          dispatched &&
+          backend.actions.contains('released') &&
+          !backend.actions.contains('play') &&
+          coordinator.snapshot.confirmations.isEmpty;
+      return DiagnosticReport(
+        passed,
+        passed
+            ? '共享合同检查通过：准备仍pending时停止已派发，迟到资源已释放；没有产生播放确认。'
+            : '共享合同检查失败，请保留日志',
+      );
+    } finally {
+      await coordinator.dispose();
+      await backend.close();
+    }
+  }
+
+  static Future<DiagnosticReport> recovery() async {
+    final root = Directory(
+      '${Directory.systemTemp.path}${Platform.pathSeparator}jj-music-diagnostics${Platform.pathSeparator}prototype-recovery',
+    );
+    FileSnapshotStore store() => FileSnapshotStore(
+      root: root,
+      runId: _runId,
+      allowedFixtureIds: {'tone-a'},
+    );
+    final s = store();
+    final before = await s.load();
+    final revision = (before.snapshot?.revision ?? 0) + 1;
+    final input = RecoverySnapshot(
+      runId: _runId,
+      revision: revision,
+      playbackSessionId: 'diagnostic-session',
+      entries: [_entry],
+      currentIndex: 0,
+      positionMs: 1234,
+    );
+    final receipt = await s.save(input);
+    final loaded = await store().load();
+    final passed =
+        receipt.revision == revision &&
+        loaded.snapshot?.revision == revision &&
+        loaded.snapshot?.positionMs == 1234 &&
+        loaded.restoredTransport == DesiredTransport.paused;
+    return DiagnosticReport(
+      passed,
+      passed
+          ? '快照写读检查通过：已落盘修订 $revision，新适配器读回1234ms，恢复意图为暂停。\n隔离目录：${s.directory.path}\n这不是跨进程或强杀恢复验收。'
+          : '快照检查失败，请保留诊断目录',
+    );
+  }
+}
+
+/// Diagnostic-only I/O boundary; deliberately produces no audio or platform events.
+class _PendingDiagnosticBackend implements PlaybackBackend {
+  final preparation = Completer<PreparedTrack>();
+  final actions = <String>[];
+  final _events = StreamController<BackendEvent>.broadcast();
+  @override
+  Stream<BackendEvent> get events => _events.stream;
+  @override
+  Future<PreparedTrack> prepare(PrepareRequest request) => preparation.future;
+  @override
+  Future<void> cancelPrepare(String requestId) async {
+    actions.add('cancel');
+  }
+
+  @override
+  Future<void> pause() async {
+    actions.add('pause');
+  }
+
+  @override
+  Future<void> stop() async {
+    actions.add('stop');
+  }
+
+  @override
+  Future<void> play(String handle) async {
+    actions.add('play');
+  }
+
+  @override
+  Future<void> seek(String handle, int positionMs) async {}
+  @override
+  Future<ReleaseReceipt> release(
+    String handle,
+    String consumer,
+    int epoch,
+  ) async {
+    actions.add('released');
+    return ReleaseReceipt(handle, consumer, epoch);
+  }
+
+  Future<void> close() => _events.close();
+}
diff --git a/clients/flutter/lib/application/playback/playback_coordinator.dart b/clients/flutter/lib/application/playback/playback_coordinator.dart
new file mode 100644
index 0000000..1783272
--- /dev/null
+++ b/clients/flutter/lib/application/playback/playback_coordinator.dart
@@ -0,0 +1,687 @@
+import 'dart:async';
+import 'dart:convert';
+
+import '../../domain/playback/contracts.dart';
+
+class _Track {
+  _Track(this.request, this.resource);
+  final PrepareRequest request;
+  final PreparedTrack resource;
+  TrackRole role = TrackRole.prepared;
+  int sequence = -1;
+  bool revoked = false;
+  String? confirmation;
+  String? transitionId;
+  Timer? releaseTimer;
+  TrackSnapshot get snapshot => TrackSnapshot(
+    trackHandleId: resource.trackHandleId,
+    entry: request.entry,
+    consumerId: resource.consumerId,
+    resourceRevision: resource.resourceRevision,
+    role: role,
+    backendEpoch: request.backendEpoch,
+    generation: request.generation,
+    revoked: revoked,
+    playbackConfirmationId: confirmation,
+  );
+}
+
+/// In-isolate authority only. Cross-engine host survival is explicitly A04/A07.
+/// Every command commits synchronously; no backend Future enters a command chain.
+class PlaybackCoordinator {
+  PlaybackCoordinator(
+    this.backend, {
+    this.sessionId = 'fixture-session',
+    this.releaseTimeout = const Duration(seconds: 3),
+  }) {
+    _subscription = backend.events.listen(
+      _onEvent,
+      onError: (Object error) => _fail('backend-stream', 'events'),
+    );
+  }
+  final PlaybackBackend backend;
+  final String sessionId;
+  final Duration releaseTimeout;
+  late final StreamSubscription<BackendEvent> _subscription;
+  String _owner = 'owner-1';
+  int _epoch = 1, _generation = 0, _revision = 0, _cursor = 0;
+  final int _backendEpoch = 1;
+  int _confirmationCounter = 0;
+  String? _ui, _active, _currentRequest, _requested;
+  int _position = 0;
+  int? _duration;
+  bool _preview = false, _disposed = false;
+  PlaybackMode _mode = PlaybackMode.sequence;
+  DesiredTransport _desired = DesiredTransport.stopped;
+  List<QueueEntry> _entries = [];
+  final _tracks = <String, _Track>{};
+  final _pending = <String, PrepareRequest>{};
+  final _preparing = <String>{};
+  PrepareRequest? _waitingPrepare;
+  Timer? _capacityTimer;
+  final _acks = <String, (String, CommandAck)>{};
+  final _confirmations = <String>[];
+  final _failures = <PlaybackFailure>[];
+  List<PlaybackFailure> get failures => List.unmodifiable(_failures);
+  ControllerClaim get claim => ControllerClaim(_owner, _epoch, sessionId);
+  CommandAck? acknowledgement(String requestId) => _acks[requestId]?.$2;
+  PlaybackSnapshot get snapshot => PlaybackSnapshot(
+    playbackSessionId: sessionId,
+    coordinatorEpoch: _epoch,
+    backendEpoch: _backendEpoch,
+    brokerEpoch: 1,
+    playbackGeneration: _generation,
+    queueRevision: _revision,
+    eventCursor: _cursor,
+    desired: _desired,
+    entries: _entries,
+    tracks: _tracks.values.map((t) => t.snapshot).toList(),
+    confirmations: _confirmations,
+    currentEntryId: _active == null
+        ? null
+        : _tracks[_active]?.request.entry.entryId,
+    requestedEntryId: _requested,
+    uiConnectionId: _ui,
+    positionMs: _position,
+    durationMs: _duration,
+    preview: _preview,
+    mode: _mode,
+  );
+
+  PlaybackSnapshot attachUi(String connectionId) {
+    _ui = connectionId;
+    return snapshot;
+  }
+
+  ControllerClaim? acquireController({
+    required String expectedOwner,
+    required String newOwner,
+  }) {
+    if (_disposed || expectedOwner != _owner || newOwner.isEmpty) {
+      return null;
+    }
+    _invalidatePrepare();
+    _generation++;
+    _currentRequest = null;
+    _owner = newOwner;
+    _epoch++;
+    _cursor++;
+    return claim;
+  }
+
+  CommandAck? _existing(CommandContext c, String signature) {
+    if (_disposed ||
+        c.protocolVersion != playbackProtocolVersion ||
+        c.requestId.isEmpty ||
+        c.claim.ownerId != _owner ||
+        c.claim.coordinatorEpoch != _epoch ||
+        c.claim.playbackSessionId != sessionId) {
+      return _reject(c, 'stale-controller');
+    }
+    final old = _acks[c.requestId];
+    if (old != null) {
+      return old.$1 == signature ? old.$2 : _reject(c, 'request-id-conflict');
+    }
+    if (_acks.length >= 256) {
+      return _reject(c, 'diagnostic-command-limit');
+    }
+    return null;
+  }
+
+  CommandAck _reject(CommandContext c, String code) =>
+      CommandAck(c.requestId, failure: PlaybackFailure(code, 'accept'));
+  CommandAck _applied(CommandContext c, String signature) {
+    final ack = CommandAck(c.requestId, accepted: true, applied: true);
+    _acks[c.requestId] = (signature, ack);
+    _cursor++;
+    return ack;
+  }
+
+  void _fail(String code, String stage) {
+    if (_disposed) {
+      return;
+    }
+    if (_failures.length == 32) {
+      _failures.removeAt(0);
+    }
+    _failures.add(PlaybackFailure(code, stage));
+    _cursor++;
+  }
+
+  void _dispatch(Future<void> Function() operation, String stage) {
+    try {
+      unawaited(
+        operation().catchError((Object error) {
+          _fail('backend-failure', stage);
+        }),
+      );
+    } catch (_) {
+      _fail('backend-failure', stage);
+    }
+  }
+
+  bool _validEntries(List<QueueEntry> entries) =>
+      entries.isNotEmpty &&
+      entries.length <= 16 &&
+      entries.map((e) => e.entryId).toSet().length == entries.length &&
+      entries.every(
+        (e) =>
+            e.entryId.isNotEmpty &&
+            e.trackKey.isNotEmpty &&
+            e.fixtureId.isNotEmpty,
+      );
+  Object _queueSignature(List<QueueEntry> entries) =>
+      entries.map((e) => [e.entryId, e.trackKey, e.fixtureId]).toList();
+  String _intentSignature(PlayIntent intent) => jsonEncode([
+    'play',
+    intent.entryId,
+    intent.mode.name,
+    intent.preview,
+    _queueSignature(intent.entries),
+  ]);
+
+  CommandAck play(CommandContext c, PlayIntent intent) {
+    final signature = _intentSignature(intent);
+    final old = _existing(c, signature);
+    if (old != null) {
+      return old;
+    }
+    if (!_validEntries(intent.entries) ||
+        !intent.entries.any((e) => e.entryId == intent.entryId)) {
+      return _reject(c, 'invalid-intent');
+    }
+    final live = _tracks.values
+        .where((t) => t.role != TrackRole.released)
+        .length;
+    final cancellable = _tracks.values.any(
+      (t) => t.role == TrackRole.prepared || t.role == TrackRole.incoming,
+    );
+    if ((live >= 2 && !cancellable) || _pending.length >= 8) {
+      return _reject(c, 'resource-capacity');
+    }
+    _invalidatePrepare();
+    _generation++;
+    _entries = intent.entries;
+    _revision++;
+    _requested = intent.entryId;
+    _preview = intent.preview;
+    _mode = intent.mode;
+    _desired = DesiredTransport.playing;
+    _currentRequest = c.requestId;
+    final request = PrepareRequest(
+      requestId: c.requestId,
+      entry: intent.entries.firstWhere((e) => e.entryId == intent.entryId),
+      generation: _generation,
+      backendEpoch: _backendEpoch,
+      transitionId: _active == null ? null : 'transition-$_generation',
+    );
+    _pending[c.requestId] = request;
+    final ack = _applied(c, signature);
+    _schedulePrepare(request);
+    return ack;
+  }
+
+  int get _reservedSlots =>
+      _preparing.length +
+      _tracks.values.where((t) => t.role != TrackRole.released).length;
+
+  void _schedulePrepare(PrepareRequest request) {
+    if (_reservedSlots >= 2) {
+      _waitingPrepare = request;
+      _capacityTimer?.cancel();
+      _capacityTimer = Timer(releaseTimeout, () {
+        if (_waitingPrepare?.requestId != request.requestId) {
+          return;
+        }
+        _waitingPrepare = null;
+        _pending.remove(request.requestId);
+        _currentRequest = null;
+        _requested = null;
+        _desired = _active == null ? DesiredTransport.paused : _desired;
+        _fail('resource-capacity-timeout', 'prepare');
+      });
+      return;
+    }
+    _preparing.add(request.requestId);
+    try {
+      unawaited(
+        backend
+            .prepare(request)
+            .then(
+              (resource) => _prepared(request, resource),
+              onError: (Object error) {
+                _pending.remove(request.requestId);
+                _preparing.remove(request.requestId);
+                if (!_disposed &&
+                    request.requestId == _currentRequest &&
+                    request.generation == _generation) {
+                  _fail('prepare-failure', 'prepare');
+                  _desired = _active == null
+                      ? DesiredTransport.stopped
+                      : DesiredTransport.playing;
+                }
+                _drainWaiting();
+              },
+            ),
+      );
+    } catch (_) {
+      _pending.remove(request.requestId);
+      _preparing.remove(request.requestId);
+      _fail('prepare-failure', 'prepare');
+      _drainWaiting();
+    }
+  }
+
+  void _drainWaiting() {
+    final next = _waitingPrepare;
+    if (_disposed || next == null || _reservedSlots >= 2) {
+      return;
+    }
+    _waitingPrepare = null;
+    _capacityTimer?.cancel();
+    if (next.generation == _generation && next.requestId == _currentRequest) {
+      _schedulePrepare(next);
+    } else {
+      _pending.remove(next.requestId);
+    }
+  }
+
+  void _invalidatePrepare() {
+    final id = _currentRequest;
+    if (_waitingPrepare != null) {
+      _pending.remove(_waitingPrepare!.requestId);
+      _waitingPrepare = null;
+      _capacityTimer?.cancel();
+    }
+    if (id != null && _preparing.contains(id)) {
+      _dispatch(() => backend.cancelPrepare(id), 'cancel');
+    }
+    for (final t
+        in _tracks.values
+            .where(
+              (t) =>
+                  (t.role == TrackRole.prepared ||
+                  t.role == TrackRole.incoming),
+            )
+            .toList()) {
+      _release(t);
+    }
+  }
+
+  void _prepared(PrepareRequest request, PreparedTrack resource) {
+    _pending.remove(request.requestId);
+    _preparing.remove(request.requestId);
+    if (resource.trackHandleId.isEmpty ||
+        resource.consumerId.isEmpty ||
+        resource.resourceRevision.isEmpty ||
+        _tracks.containsKey(resource.trackHandleId)) {
+      _fail('invalid-handle', 'prepare');
+      _drainWaiting();
+      return;
+    }
+    final track = _Track(request, resource);
+    _tracks.removeWhere((key, value) => value.role == TrackRole.released);
+    _tracks[resource.trackHandleId] = track;
+    if (_disposed ||
+        request.generation != _generation ||
+        request.requestId != _currentRequest ||
+        request.backendEpoch != _backendEpoch) {
+      // Even obsolete success owns an allocated consumer and must be cleaned up.
+      _release(track);
+      _drainWaiting();
+      return;
+    }
+    if (_desired == DesiredTransport.playing) {
+      track.role = TrackRole.incoming;
+      _dispatch(() => backend.play(resource.trackHandleId), 'play');
+    }
+    _cursor++;
+    _drainWaiting();
+  }
+
+  CommandAck pause(CommandContext c) {
+    final old = _existing(c, 'pause');
+    if (old != null) {
+      return old;
+    }
+    _desired = DesiredTransport.paused;
+    _dispatch(backend.pause, 'pause');
+    return _applied(c, 'pause');
+  }
+
+  CommandAck resume(CommandContext c) {
+    final old = _existing(c, 'resume');
+    if (old != null) {
+      return old;
+    }
+    final track = _active == null
+        ? _tracks.values
+              .where(
+                (t) =>
+                    (t.role == TrackRole.prepared ||
+                        t.role == TrackRole.incoming) &&
+                    t.request.requestId == _currentRequest,
+              )
+              .firstOrNull
+        : _tracks[_active];
+    if (track == null && !_pending.containsKey(_currentRequest)) {
+      return _reject(c, 'no-prepared-resource');
+    }
+    _desired = DesiredTransport.playing;
+    if (track != null) {
+      if (track.role == TrackRole.prepared) {
+        track.role = TrackRole.incoming;
+      }
+      _dispatch(() => backend.play(track.resource.trackHandleId), 'resume');
+    }
+    return _applied(c, 'resume');
+  }
+
+  CommandAck stop(CommandContext c) {
+    final old = _existing(c, 'stop');
+    if (old != null) {
+      return old;
+    }
+    _invalidatePrepare();
+    _generation++;
+    _currentRequest = null;
+    _requested = null;
+    _desired = DesiredTransport.stopped;
+    _active = null;
+    _position = 0;
+    _dispatch(backend.stop, 'stop');
+    for (final t in _tracks.values.toList()) {
+      _release(t);
+    }
+    return _applied(c, 'stop');
+  }
+
+  CommandAck cancel(CommandContext c, String targetRequestId) {
+    final signature = 'cancel:$targetRequestId';
+    final old = _existing(c, signature);
+    if (old != null) {
+      return old;
+    }
+    final prepared = _tracks.values
+        .where(
+          (t) =>
+              t.request.requestId == targetRequestId &&
+              (t.role == TrackRole.prepared || t.role == TrackRole.incoming),
+        )
+        .toList();
+    if (_pending.containsKey(targetRequestId) || prepared.isNotEmpty) {
+      if (_preparing.contains(targetRequestId)) {
+        _dispatch(() => backend.cancelPrepare(targetRequestId), 'cancel');
+      }
+      if (_waitingPrepare?.requestId == targetRequestId) {
+        _waitingPrepare = null;
+        _capacityTimer?.cancel();
+        _pending.remove(targetRequestId);
+      }
+      for (final t in prepared) {
+        _release(t);
+      }
+      if (_currentRequest == targetRequestId) {
+        _generation++;
+        _currentRequest = null;
+        _requested = null;
+        _desired = _active == null
+            ? DesiredTransport.stopped
+            : DesiredTransport.playing;
+      }
+    }
+    return _applied(c, signature);
+  }
+
+  CommandAck seek(CommandContext c, int positionMs) {
+    final signature = 'seek:$positionMs';
+    final old = _existing(c, signature);
+    if (old != null) {
+      return old;
+    }
+    if (positionMs < 0 || _active == null) {
+      return _reject(c, 'invalid-seek');
+    }
+    _invalidatePrepare();
+    _generation++;
+    _currentRequest = null;
+    for (final t
+        in _tracks.values
+            .where(
+              (t) =>
+                  (t.role == TrackRole.prepared ||
+                      t.role == TrackRole.incoming) ||
+                  t.role == TrackRole.outgoing,
+            )
+            .toList()) {
+      _release(t);
+    }
+    _dispatch(() => backend.seek(_active!, positionMs), 'seek');
+    _position = positionMs;
+    return _applied(c, signature);
+  }
+
+  CommandAck replaceQueue(
+    CommandContext c,
+    List<QueueEntry> entries,
+    int expectedRevision,
+  ) {
+    final signature = jsonEncode([
+      'queue',
+      expectedRevision,
+      _queueSignature(entries),
+    ]);
+    final old = _existing(c, signature);
+    if (old != null) {
+      return old;
+    }
+    if (expectedRevision != _revision || !_validEntries(entries)) {
+      return _reject(c, 'queue-conflict');
+    }
+    final activeId = snapshot.currentEntryId;
+    if (activeId != null && !entries.any((e) => e.entryId == activeId)) {
+      return _reject(c, 'diagnostic-active-removal-unsupported');
+    }
+    if (_requested != null && !entries.any((e) => e.entryId == _requested)) {
+      _invalidatePrepare();
+      _generation++;
+      _currentRequest = null;
+      _requested = null;
+      if (_active == null) {
+        _desired = DesiredTransport.stopped;
+      }
+    }
+    _entries = List.unmodifiable(entries);
+    _revision++;
+    return _applied(c, signature);
+  }
+
+  void _onEvent(BackendEvent event) {
+    if (_disposed || event.backendEpoch != _backendEpoch) {
+      return;
+    }
+    final t = _tracks[event.trackHandleId];
+    if (t == null ||
+        event.backendEpoch != t.request.backendEpoch ||
+        event.requestId != t.request.requestId ||
+        event.generation != t.request.generation ||
+        event.eventSequence <= t.sequence) {
+      return;
+    }
+    t.sequence = event.eventSequence;
+    if (event.kind == BackendEventKind.released) {
+      _acceptRelease(
+        t,
+        ReleaseReceipt(
+          t.resource.trackHandleId,
+          t.resource.consumerId,
+          event.backendEpoch,
+        ),
+      );
+      return;
+    }
+    if (t.role == TrackRole.retiring ||
+        t.role == TrackRole.released ||
+        t.revoked) {
+      return;
+    }
+    // Outgoing owns its resource despite having an earlier playback generation.
+    if ((t.role == TrackRole.prepared || t.role == TrackRole.incoming) &&
+        (t.request.generation != _generation ||
+            t.request.requestId != _currentRequest)) {
+      return;
+    }
+    switch (event.kind) {
+      case BackendEventKind.playing:
+        if (_desired != DesiredTransport.playing ||
+            event.confirmationEvidence == null ||
+            event.confirmationEvidence!.isEmpty) {
+          return;
+        }
+        if (t.confirmation == null) {
+          t.confirmation = '$sessionId:${++_confirmationCounter}';
+          if (_confirmations.length == 64) {
+            _confirmations.removeAt(0);
+          }
+          _confirmations.add(t.confirmation!);
+        }
+        if ((t.role == TrackRole.prepared || t.role == TrackRole.incoming) &&
+            event.transitionId == t.request.transitionId) {
+          final previous = _active == null ? null : _tracks[_active];
+          if (previous != null && previous != t) {
+            previous.role = TrackRole.outgoing;
+          }
+          t.transitionId = event.transitionId;
+          t.role = TrackRole.active;
+          _active = t.resource.trackHandleId;
+          _position = event.positionMs;
+          _duration = event.durationMs;
+        }
+      case BackendEventKind.error:
+        _fail('backend-error', 'event');
+        if (_active == t.resource.trackHandleId) {
+          final fallback = _tracks.values
+              .where((v) => v.role == TrackRole.outgoing && !v.revoked)
+              .firstOrNull;
+          if (fallback != null) {
+            fallback.role = TrackRole.active;
+            _active = fallback.resource.trackHandleId;
+            _dispatch(() => backend.play(_active!), 'rollback');
+          } else {
+            _active = null;
+            _desired = DesiredTransport.paused;
+          }
+        }
+        _release(t);
+      case BackendEventKind.progress:
+        if (_active == t.resource.trackHandleId && event.positionMs >= 0) {
+          _position = event.positionMs;
+          _duration = event.durationMs;
+        }
+      case BackendEventKind.ended:
+        // Queue advancement is not delegated to a native callback in A02.
+        if (_active == t.resource.trackHandleId) {
+          _desired = _preview
+              ? DesiredTransport.stopped
+              : DesiredTransport.paused;
+        }
+        _release(t);
+      case BackendEventKind.ready:
+      case BackendEventKind.buffering:
+      case BackendEventKind.released:
+        break;
+    }
+    _cursor++;
+  }
+
+  void completeTransition(String incomingHandle, {String? transitionId}) {
+    if (_disposed ||
+        _active != incomingHandle ||
+        _tracks[incomingHandle]?.request.transitionId != transitionId) {
+      return;
+    }
+    for (final t
+        in _tracks.values.where((t) => t.role == TrackRole.outgoing).toList()) {
+      _release(t);
+    }
+  }
+
+  void revokeResource(String handle) {
+    final t = _tracks[handle];
+    if (t == null || t.role == TrackRole.released) {
+      return;
+    }
+    t.revoked = true;
+    if (_active == handle) {
+      _active = null;
+      _desired = DesiredTransport.paused;
+    }
+    _release(t);
+  }
+
+  void _release(_Track t) {
+    if (t.role == TrackRole.retiring || t.role == TrackRole.released) {
+      return;
+    }
+    t.role = TrackRole.retiring;
+    if (!_disposed) {
+      t.releaseTimer = Timer(releaseTimeout, () {
+        _fail('release-timeout', 'release');
+      });
+    }
+    try {
+      unawaited(
+        backend
+            .release(
+              t.resource.trackHandleId,
+              t.resource.consumerId,
+              t.request.backendEpoch,
+            )
+            .then(
+              (receipt) => _acceptRelease(t, receipt),
+              onError: (Object error) {
+                t.releaseTimer?.cancel();
+                _fail('release-failure', 'release');
+              },
+            ),
+      );
+    } catch (_) {
+      t.releaseTimer?.cancel();
+      _fail('release-failure', 'release');
+    }
+  }
+
+  void _acceptRelease(_Track t, ReleaseReceipt receipt) {
+    if (receipt.trackHandleId != t.resource.trackHandleId ||
+        receipt.consumerId != t.resource.consumerId ||
+        receipt.backendEpoch != t.request.backendEpoch) {
+      _fail('invalid-release-receipt', 'release');
+      return;
+    }
+    t.releaseTimer?.cancel();
+    t.role = TrackRole.released;
+    if (_active == t.resource.trackHandleId) {
+      _active = null;
+    }
+    if (!_disposed) {
+      _cursor++;
+      _drainWaiting();
+    }
+  }
+
+  Future<void> dispose() async {
+    if (_disposed) {
+      return;
+    }
+    _invalidatePrepare();
+    _disposed = true;
+    _capacityTimer?.cancel();
+    _generation++;
+    _currentRequest = null;
+    await _subscription.cancel();
+    for (final t in _tracks.values) {
+      _release(t);
+      t.releaseTimer?.cancel();
+    }
+  }
+}
diff --git a/clients/flutter/lib/data/prototype_recovery/file_snapshot_store.dart b/clients/flutter/lib/data/prototype_recovery/file_snapshot_store.dart
new file mode 100644
index 0000000..e8afe8e
--- /dev/null
+++ b/clients/flutter/lib/data/prototype_recovery/file_snapshot_store.dart
@@ -0,0 +1,144 @@
+import 'dart:convert';
+import 'dart:io';
+
+import '../../domain/playback/recovery_snapshot.dart';
+
+class _WriteQueue {
+  Future<void> tail = Future.value();
+  int pending = 0;
+}
+
+/// P1 fixture-only two-slot journal. Not a production DB or a power-loss guarantee.
+class FileSnapshotStore implements RecoverySnapshotStore {
+  FileSnapshotStore({
+    required Directory root,
+    required this.runId,
+    required Set<String> allowedFixtureIds,
+  }) : allowedFixtureIds = Set.unmodifiable(allowedFixtureIds),
+       directory = Directory(
+         '${root.absolute.path}${Platform.pathSeparator}$runId',
+       ) {
+    if (!_id.hasMatch(runId)) {
+      throw const FormatException('invalid-run-id');
+    }
+  }
+  static const maxBytes = 256 * 1024;
+  static final _id = RegExp(r'^[A-Za-z0-9_-]{1,80}$');
+  static final _queues = <String, _WriteQueue>{};
+  final String runId;
+  final Directory directory;
+  final Set<String> allowedFixtureIds;
+
+  void _validate(RecoverySnapshot s) {
+    if (s.runId != runId ||
+        !_id.hasMatch(s.playbackSessionId) ||
+        s.revision < 0 ||
+        s.positionMs < 0 ||
+        s.entries.length > 16 ||
+        s.confirmations.length > 64 ||
+        s.entries.map((e) => e.entryId).toSet().length != s.entries.length ||
+        (s.entries.isEmpty
+            ? s.currentIndex != -1
+            : s.currentIndex < 0 || s.currentIndex >= s.entries.length)) {
+      throw const FormatException('invalid-snapshot');
+    }
+    for (final e in s.entries) {
+      if (!_id.hasMatch(e.entryId) ||
+          !_id.hasMatch(e.trackKey) ||
+          !allowedFixtureIds.contains(e.fixtureId)) {
+        throw const FormatException('fixture-unavailable');
+      }
+    }
+    if (s.confirmations.any(
+      (id) => !RegExp(r'^[A-Za-z0-9_:.-]{1,128}$').hasMatch(id),
+    )) {
+      throw const FormatException('invalid-confirmation');
+    }
+  }
+
+  @override
+  Future<SnapshotSaveReceipt> save(RecoverySnapshot snapshot) {
+    final key = directory.absolute.path.toLowerCase();
+    final queue = _queues.putIfAbsent(key, _WriteQueue.new);
+    if (queue.pending >= 8) {
+      return Future.error(StateError('snapshot-write-capacity'));
+    }
+    queue.pending++;
+    final result = queue.tail.then((_) => _write(snapshot));
+    void finished() {
+      queue.pending--;
+      if (queue.pending == 0 && identical(_queues[key], queue)) {
+        _queues.remove(key);
+      }
+    }
+
+    queue.tail = result.then<void>(
+      (_) {
+        finished();
+      },
+      onError: (Object error, StackTrace stack) {
+        finished();
+      },
+    );
+    return result;
+  }
+
+  Future<SnapshotSaveReceipt> _write(RecoverySnapshot snapshot) async {
+    _validate(snapshot);
+    final encoded = utf8.encode(jsonEncode(snapshot.toJson()));
+    if (encoded.length > maxBytes) {
+      throw const FormatException('snapshot-too-large');
+    }
+    final previous = (await load()).snapshot;
+    if (previous != null && snapshot.revision <= previous.revision) {
+      if (snapshot.revision == previous.revision &&
+          jsonEncode(snapshot.toJson()) == jsonEncode(previous.toJson())) {
+        return SnapshotSaveReceipt(runId, snapshot.revision);
+      }
+      throw StateError('stale-snapshot-revision');
+    }
+    await directory.create(recursive: true);
+    final name = snapshot.revision.isEven
+        ? 'snapshot-a.json'
+        : 'snapshot-b.json';
+    final target = File('${directory.path}${Platform.pathSeparator}$name');
+    final temporary = File('${target.path}.tmp');
+    await temporary.writeAsBytes(encoded, flush: true);
+    await temporary.rename(target.path);
+    return SnapshotSaveReceipt(runId, snapshot.revision);
+  }
+
+  @override
+  Future<SnapshotReadResult> load() async {
+    RecoverySnapshot? latest;
+    final issues = <String>[];
+    for (final name in ['snapshot-a.json', 'snapshot-b.json']) {
+      final file = File('${directory.path}${Platform.pathSeparator}$name');
+      if (!await file.exists()) {
+        continue;
+      }
+      try {
+        // Bound the actual read as well as metadata: external replacement cannot allocate an arbitrary file.
+        final data = await file
+            .openRead(0, maxBytes + 1)
+            .fold<List<int>>(<int>[], (bytes, chunk) => bytes..addAll(chunk));
+        if (data.length > maxBytes) {
+          issues.add('snapshot-too-large');
+          continue;
+        }
+        final value = jsonDecode(utf8.decode(data));
+        if (value is! Map<String, dynamic>) {
+          throw const FormatException('invalid-snapshot');
+        }
+        final candidate = RecoverySnapshot.decode(value);
+        _validate(candidate);
+        if (latest == null || candidate.revision > latest.revision) {
+          latest = candidate;
+        }
+      } catch (_) {
+        issues.add('snapshot-invalid-or-unreadable');
+      }
+    }
+    return SnapshotReadResult(latest, issues);
+  }
+}
diff --git a/clients/flutter/lib/domain/playback/contracts.dart b/clients/flutter/lib/domain/playback/contracts.dart
new file mode 100644
index 0000000..036ea6c
--- /dev/null
+++ b/clients/flutter/lib/domain/playback/contracts.dart
@@ -0,0 +1,217 @@
+import 'dart:async';
+
+const playbackProtocolVersion = 1;
+
+enum DesiredTransport { stopped, paused, playing }
+
+enum PlaybackMode { sequence, repeatOne, repeatAll, shuffle }
+
+enum TrackRole { prepared, active, incoming, outgoing, retiring, released }
+
+enum BackendEventKind {
+  ready,
+  playing,
+  buffering,
+  progress,
+  ended,
+  error,
+  released,
+}
+
+class QueueEntry {
+  const QueueEntry({
+    required this.entryId,
+    required this.trackKey,
+    required this.fixtureId,
+  });
+  final String entryId;
+  final String trackKey;
+  final String fixtureId;
+}
+
+class ControllerClaim {
+  const ControllerClaim(
+    this.ownerId,
+    this.coordinatorEpoch,
+    this.playbackSessionId,
+  );
+  final String ownerId;
+  final int coordinatorEpoch;
+  final String playbackSessionId;
+}
+
+class CommandContext {
+  const CommandContext(
