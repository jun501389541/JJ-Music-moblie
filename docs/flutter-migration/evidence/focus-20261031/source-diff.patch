+    checks.add('explicit-resume-same-confirmation');
+    await NativeLocalBackend.channel.invokeMethod<void>('captureFocusCallback');
+    r.command('pause');
+    await _until(() => r.backend.lastHost['focusHeld'] == false);
+    r.command('play');
