@@ -0,0 +1,87 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:jj_music_mobile/application/playback/playback_coordinator.dart';
+import 'package:jj_music_mobile/domain/playback/contracts.dart';
+import 'package:jj_music_mobile/domain/playback/recovery_snapshot.dart';
+
+import '../../integration_test/support/controlled_backend.dart';
+
+void main() {
+  test(
+    'valid empty persisted snapshot restores safe paused empty state',
+    () async {
+      final b = ControlledBackend();
+      final c = PlaybackCoordinator(b, sessionId: 'empty');
+      c.restoreSnapshot(
+        RecoverySnapshot(
+          runId: 'owned',
+          revision: 1,
+          playbackSessionId: 'empty',
+          entries: [],
+          currentIndex: -1,
+        ),
+      );
+      expect(c.snapshot.entries, isEmpty);
+      expect(c.snapshot.desired, DesiredTransport.paused);
+      expect(b.actions, isEmpty);
+      await c.dispose();
+      await b.close();
+    },
+  );
+  test('confirmed backend destruction advances only backend epoch and rejects stale events', () async {
+    final b = ControlledBackend();
+    final c = PlaybackCoordinator(b);
+    const e = QueueEntry(entryId: 'a', trackKey: 'owned', fixtureId: 'tone-a');
+    c.play(
+      CommandContext('p', c.claim),
+      PlayIntent(entries: [e], entryId: 'a'),
+    );
+    b.ready('p', 'h');
+    await Future<void>.delayed(Duration.zero);
+    b.emit('p', 'h', BackendEventKind.playing, 1);
+    final before = c.snapshot;
+    expect(
+      c.backendReleased(CommandContext('lost', c.claim), [
+        const ReleaseReceipt('h', 'consumer-h', 1),
+      ]).applied,
+      isTrue,
+    );
+    expect(c.snapshot.backendEpoch, before.backendEpoch + 1);
+    expect(c.snapshot.coordinatorEpoch, before.coordinatorEpoch);
+    expect(c.snapshot.brokerEpoch, before.brokerEpoch);
+    expect(c.snapshot.desired, DesiredTransport.paused);
+    b.emit('p', 'h', BackendEventKind.ended, 9);
+    expect(c.snapshot.confirmations.length, 1);
+    await c.dispose();
+    await b.close();
+  });
+  test('R3 restore stays paused without native handles and resumes at saved position', () async {
+    final b = ControlledBackend();
+    final c = PlaybackCoordinator(b, sessionId: 'logical');
+    const e = QueueEntry(
+      entryId: 'saved',
+      trackKey: 'owned',
+      fixtureId: 'tone-a',
+    );
+    final s = RecoverySnapshot(
+      runId: 'owned',
+      revision: 2,
+      playbackSessionId: 'logical',
+      entries: [e],
+      currentIndex: 0,
+      positionMs: 2345,
+      confirmations: ['logical:4'],
+    );
+    // This callable is introduced as an A02-owned additive v2 recovery extension.
+    c.restoreSnapshot(s);
+    expect(c.snapshot.desired, DesiredTransport.paused);
+    expect(c.snapshot.positionMs, 2345);
+    expect(c.snapshot.currentEntryId, 'saved');
+    expect(b.actions, isEmpty);
+    c.resume(CommandContext('resume', c.claim));
+    expect(c.resume(CommandContext('resume', c.claim)).applied, isTrue);
+    expect(b.pending.values, isNotEmpty);
+    expect(b.requests.values.single.startPositionMs, 2345);
+    await c.dispose();
+    await b.close();
+  });
+}
diff --git a/clients/flutter/tool/generate_long_fixture.dart b/clients/flutter/tool/generate_long_fixture.dart
new file mode 100644
index 0000000..3ed2326
--- /dev/null
+++ b/clients/flutter/tool/generate_long_fixture.dart
@@ -0,0 +1,36 @@
+import 'dart:io';
+import 'dart:math' as math;
+import 'dart:typed_data';
+
+void main() {
+  const rate = 16000, samples = rate * 12;
+  final b = ByteData(44 + samples * 2);
+  void text(int at, String s) {
+    for (var i = 0; i < s.length; i++) {
+      b.setUint8(at + i, s.codeUnitAt(i));
+    }
+  }
+
+  text(0, 'RIFF');
+  b.setUint32(4, 36 + samples * 2, Endian.little);
+  text(8, 'WAVE');
+  text(12, 'fmt ');
+  b.setUint32(16, 16, Endian.little);
+  b.setUint16(20, 1, Endian.little);
+  b.setUint16(22, 1, Endian.little);
+  b.setUint32(24, rate, Endian.little);
+  b.setUint32(28, rate * 2, Endian.little);
+  b.setUint16(32, 2, Endian.little);
+  b.setUint16(34, 16, Endian.little);
+  text(36, 'data');
+  b.setUint32(40, samples * 2, Endian.little);
+  for (var i = 0; i < samples; i++) {
+    b.setInt16(
+      44 + i * 2,
+      (math.sin(i * 2 * math.pi * 440 / rate) * 1500).round(),
+      Endian.little,
+    );
+  }
+  File('fixtures/local_playback/tone-long.wav')
+      .writeAsBytesSync(b.buffer.asUint8List());
+}
diff --git a/clients/flutter/tool/run_android_recovery_probe.ps1 b/clients/flutter/tool/run_android_recovery_probe.ps1
new file mode 100644
index 0000000..eb9d379
--- /dev/null
+++ b/clients/flutter/tool/run_android_recovery_probe.ps1
@@ -0,0 +1,46 @@
+param([Parameter(Mandatory=$true)][string]$DeviceId)
+$ErrorActionPreference='Stop'
+$client=Split-Path $PSScriptRoot -Parent
+$workspace=[IO.Path]::GetFullPath((Join-Path $client '../..'))
+$adb='E:/Android/sdk/platform-tools/adb.exe'
+$package='dev.jjmusic.diagnostics.jj_music_mobile'
+$apk=Join-Path $client 'build/app/outputs/flutter-apk/app-release.apk'
+& $adb -s $DeviceId install -r $apk
+if($LASTEXITCODE -ne 0){throw 'Installation failed'}
+function Start-Probe([string]$mode){
+  $token=[Guid]::NewGuid().ToString('N')
+  & $adb -s $DeviceId shell am start -n "$package/.MainActivity" --es p1Mode $mode --es p1Token $token | Out-Null
+  if($LASTEXITCODE -ne 0){throw 'Start failed'}
+  $deadline=[DateTime]::UtcNow.AddSeconds(25)
+  while([DateTime]::UtcNow -lt $deadline){
+    $processId=([string](& $adb -s $DeviceId shell pidof $package)).Trim()
+    if($processId -match '^\d+$'){
+      $log=& $adb -s $DeviceId logcat -d --pid=$processId -s 'JJOwnedProbe:I' '*:S'
+      foreach($line in $log){
+        if($line -match 'JJOwnedProbe:\s*(\{.+\})'){
+          $value=$Matches[1]|ConvertFrom-Json
+          if($value.probeToken -ne $token){continue}
+          if($value.stage -eq 'error'){throw "Probe failure: $($value.error)"}
