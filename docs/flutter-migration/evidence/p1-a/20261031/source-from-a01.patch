+      final s = snapshot;
+      final running = (backend.lastHost['samples'] as List? ?? []).any(
+        (v) =>
+            v['nativePlaying'] == true &&
+            s.tracks.any(
+              (t) =>
+                  t.trackHandleId == v['id'] &&
+                  t.role == TrackRole.active &&
+                  t.playbackConfirmationId != null,
